{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "node",
    "module": "es2020",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "paths": {
      "wouter-preact": ["./types/index.d.ts"],
      "wouter-preact/use-browser-location": ["./types/use-browser-location.d.ts"],
      "wouter-preact/use-hash-location": ["./types/use-hash-location.d.ts"],
      "wouter-preact/memory-location": ["./types/memory-location.d.ts"],
      "wouter": ["../wouter/src/index.js"],
      "wouter/use-browser-location": ["../wouter/src/use-browser-location.js"],
      "wouter/use-hash-location": ["../wouter/src/use-hash-location.js"],
      "wouter/memory-location": ["../wouter/src/memory-location.js"]
    },
    "types": ["bun", "@testing-library/jest-dom", "preact"],
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/**/*"]
}
